+        // A twin of PatchBlobAssets*: the same walk over the archetype, but we have no offset table of our own —
+        // every contiguous run of elements goes into the external Blobcheg hook.
+        internal static void PatchBlobchegRefsInChunk(Archetype* archetype, byte* chunkBuffer, int entityCount, int mode)
+        {
+            if (!BlobchegPatchHook.IsInstalled)
+                return;
+
+            // An empty chunk: there is nothing to walk the archetype for, the hook would only get runs of zero length.
+            if (entityCount <= 0)
+                return;
+
+            var hook = BlobchegPatchHook.PatchElementsHook;
+            var typeCount = archetype->TypesCount;
+            for (var unordered_ti = 0; unordered_ti < typeCount; ++unordered_ti)
+            {
+                var ti = archetype->TypeMemoryOrderIndexToIndexInArchetype[unordered_ti];
+                var type = archetype->Types[ti];
+                if (type.IsZeroSized || type.IsManagedComponent)
+                    continue;
+
+                var typeIndex = type.TypeIndex.Value;
+                var strideSize = archetype->SizeOfs[ti];
+                byte* componentArrayStart = OffsetFromPointer(chunkBuffer, archetype->Offsets[ti]);
+
+                if (type.IsBuffer)
+                {
+                    ref readonly var ct = ref TypeManager.GetTypeInfo(type.TypeIndex);
+                    var elementSize = ct.ElementSize;
+                    var header = (BufferHeader*)componentArrayStart;
+
+                    // Buffers are contiguous only within one entity, hence a call per entity.
+                    for (int bi = 0; bi < entityCount; ++bi)
+                    {
+                        if (header->Length > 0)
+                            hook.Invoke(typeIndex, BufferHeader.GetElementPointer(header), header->Length, elementSize, mode);
+
+                        header = (BufferHeader*)OffsetFromPointer(header, strideSize);
+                    }
+                }
+                else
+                {
+                    hook.Invoke(typeIndex, componentArrayStart, entityCount, strideSize, mode);
+                }
+            }
+        }
