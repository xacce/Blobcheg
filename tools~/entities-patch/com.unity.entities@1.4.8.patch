@@ -0,0 +1,56 @@
+using System;
+using System.Runtime.InteropServices;
+using Unity.Burst;
+
+namespace Unity.Entities
+{
+    /// <summary>
+    /// The extension point for a third-party reference contour (the Blobcheg package).
+    /// The fork only calls a hook installed from the outside — the patch logic does not move in here.
+    /// </summary>
+    public static unsafe class BlobchegPatchHook
+    {
+        /// <summary>
+        /// A run over the elements of one component of one archetype.
+        /// <paramref name="mode"/>: 0 — turn an offset into an address (after loading),
+        /// 1 — fold an address back into an offset (before writing).
+        /// </summary>
+        [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+        public delegate void PatchElements(int typeIndex, byte* elements, int elementCount, int elementStride, int mode);
+
+        // A SharedStatic key: chunk serialisation runs from Burst, and an ordinary static is invisible there.
+        private struct PatchElementsKey
+        {
+        }
+
+        private static readonly SharedStatic<FunctionPointer<PatchElements>> s_PatchElements =
+            SharedStatic<FunctionPointer<PatchElements>>.GetOrCreate<PatchElementsKey>();
+
+        /// <summary>
+        /// The pointer to the element run. Set from the outside; default means there is no hook.
+        /// </summary>
+        public static FunctionPointer<PatchElements> PatchElementsHook
+        {
+            get => s_PatchElements.Data;
+            set => s_PatchElements.Data = value;
+        }
+
+        /// <summary>
+        /// Whether the hook is installed. Read from Burst too — the archetype walk does not start for nothing.
+        /// </summary>
+        public static bool IsInstalled => s_PatchElements.Data.IsCreated;
+
+        /// <summary>
+        /// The live path: the change set has already landed in the world, its references are still raw.
+        /// </summary>
+        public static Action<EntityManager> AfterApplyChangeSet;
+
+        /// <summary>
+        /// The end of world serialisation: every chunk was walked, the reverse pass has run.
+        /// The Blobcheg side piles the failures of the reverse pass into its mailbox silently
+        /// (Burst cannot assemble messages) — this is the only place where they can be
+        /// raised into an exception while the serialisation is not yet counted as successful.
+        /// </summary>
+        public static Action AfterSerializeWorld;
+    }
+}
