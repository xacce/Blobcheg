+using System;
+using System.Runtime.InteropServices;
+using Unity.Burst;
+
+namespace Unity.Entities
+{
+    /// <summary>
+    /// Точка расширения для стороннего контура ссылок (пакет Blobcheg).
+    /// Форк только зовёт установленный снаружи хук — логика патча сюда не переезжает.
+    /// </summary>
+    public static unsafe class BlobchegPatchHook
+    {
+        /// <summary>
+        /// Прогон элементов одного компонента одного архетипа.
+        /// <paramref name="mode"/>: 0 — оффсет превратить в адрес (после загрузки),
+        /// 1 — адрес свернуть обратно в оффсет (перед записью).
+        /// </summary>
+        [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+        public delegate void PatchElements(int typeIndex, byte* elements, int elementCount, int elementStride, int mode);
+
+        // Ключ SharedStatic: сериализация чанков идёт из Burst, обычный static оттуда не виден.
+        private struct PatchElementsKey
+        {
+        }
+
+        private static readonly SharedStatic<FunctionPointer<PatchElements>> s_PatchElements =
+            SharedStatic<FunctionPointer<PatchElements>>.GetOrCreate<PatchElementsKey>();
+
+        /// <summary>
+        /// Указатель на прогон элементов. Ставится снаружи, default — хука нет.
+        /// </summary>
+        public static FunctionPointer<PatchElements> PatchElementsHook
+        {
+            get => s_PatchElements.Data;
+            set => s_PatchElements.Data = value;
+        }
+
+        /// <summary>
+        /// Установлен ли хук. Читается и из Burst — обход архетипа не начинается впустую.
+        /// </summary>
+        public static bool IsInstalled => s_PatchElements.Data.IsCreated;
+
+        /// <summary>
+        /// Живой путь: чейнджсет уже лёг в мир, ссылки в нём ещё сырые.
+        /// </summary>
+        public static Action<EntityManager> AfterApplyChangeSet;
+
+        /// <summary>
+        /// Конец сериализации мира: все чанки обойдены, обратный проход отработал.
+        /// Провалы обратного прохода сторона Blobcheg копит в своём почтовом ящике молча
+        /// (Burst не умеет собирать сообщения) — это единственное место, где их можно
+        /// поднять до исключения, пока сериализация ещё не считается успешной.
+        /// </summary>
+        public static Action AfterSerializeWorld;
+    }
+}
